---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatPlaytime } from "@/utils/game-utils";

interface Props {
	game: {
		name: string;
		hours?: number;
		minutes?: number;
		cover?: string;
		last_played?: string;
		store_url?: string;
		earned_achievements?: number;
		total_achievements?: number;
	};
	platformIcon: string;
	platformLabel: string;
	showAchievements: boolean;
}

const { game, platformIcon, platformLabel, showAchievements } = Astro.props;

const playtime = formatPlaytime(game);
const hasAchievements =
	showAchievements &&
	typeof game.total_achievements === "number" &&
	game.total_achievements > 0;
const earned = game.earned_achievements ?? 0;
const total = game.total_achievements ?? 0;
const achPercent = hasAchievements
	? Math.min(100, Math.round((earned / total) * 100))
	: 0;

const isExternal = Boolean(game.store_url);
---

<a
	href={game.store_url || "#"}
	target={isExternal ? "_blank" : undefined}
	rel={isExternal ? "noopener noreferrer" : undefined}
	class="game-card group"
>
	<div class="game-cover">
		{game.cover ? (
			<img src={game.cover} alt={game.name} class="game-img" loading="lazy" />
		) : (
			<div class="game-placeholder">
				<Icon name="material-symbols:sports-esports" class="placeholder-icon" />
			</div>
		)}
		<div class="game-gradient" />

		<span class="game-platform" title={platformLabel}>
			<Icon name={platformIcon} class="platform-icon" />
		</span>

		{isExternal && (
			<span class="game-store">
				<Icon name="material-symbols:open-in-new" class="store-icon" />
			</span>
		)}
	</div>

	<div class="game-info">
		<h3 class="game-title">{game.name}</h3>
		<div class="game-meta">
			{playtime && (
				<span class="game-meta-item">
					<Icon name="material-symbols:schedule" class="meta-icon" />
					{playtime}
				</span>
			)}
			{game.last_played && (
				<span class="game-meta-item">
					<Icon name="material-symbols:history" class="meta-icon" />
					{i18n(I18nKey.gamesLastPlayed)} {game.last_played}
				</span>
			)}
		</div>

		{hasAchievements && (
			<div class="game-achieve">
				<div class="game-achieve-head">
					<span class="game-achieve-label">
						{i18n(I18nKey.gamesAchievements)} {earned}/{total}
					</span>
					<span class="game-achieve-pct">{achPercent}%</span>
				</div>
				<div class="game-achieve-bar">
					<div
						class="game-achieve-fill"
						style={`width: ${achPercent}%`}
					/>
				</div>
			</div>
		)}
	</div>
</a>

<style>
	.game-card {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-large);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		transition: transform 0.22s cubic-bezier(.23,1,.32,1),
		            box-shadow 0.22s cubic-bezier(.23,1,.32,1),
		            border-color 0.22s ease;
		height: 100%;
	}
	.game-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 25px -6px rgba(0,0,0,.12), 0 0 0 1px var(--primary);
		border-color: transparent;
	}
	:global(html.dark) .game-card:hover {
		box-shadow: 0 8px 25px -6px rgba(0,0,0,.35), 0 0 0 1px var(--primary);
	}

	.game-cover {
		position: relative;
		aspect-ratio: 3/2;
		background: var(--btn-regular-bg);
		overflow: hidden;
		flex-shrink: 0;
	}
	.game-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s cubic-bezier(.23,1,.32,1);
	}
	.game-card:hover .game-img {
		transform: scale(1.05);
	}

	.game-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--btn-regular-bg), var(--btn-card-bg-hover));
	}
	.placeholder-icon {
		font-size: 2rem;
		color: var(--content-meta);
		opacity: .5;
	}

	.game-gradient {
		position: absolute;
		inset: auto 0 0 0;
		height: 40%;
		background: linear-gradient(to top, rgba(0,0,0,.45), transparent);
		pointer-events: none;
		z-index: 1;
	}

	.game-platform {
		position: absolute;
		top: 8px;
		left: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border-radius: 8px;
		background: rgba(0,0,0,.5);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: #fff;
		z-index: 3;
	}
	.platform-icon {
		font-size: 15px;
	}

	.game-store {
		position: absolute;
		top: 8px;
		right: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border-radius: 8px;
		background: rgba(0,0,0,.5);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: #fff;
		z-index: 3;
		opacity: 0;
		transition: opacity .2s ease;
	}
	.game-card:hover .game-store {
		opacity: 1;
	}
	.store-icon {
		font-size: 15px;
	}

	.game-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 10px 12px 12px;
		min-height: 0;
	}

	.game-title {
		font-size: 14px;
		font-weight: 700;
		line-height: 1.4;
		margin: 0;
		color: var(--deep-text);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.game-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
	}
	.game-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 11px;
		color: var(--content-meta);
		white-space: nowrap;
	}
	.meta-icon {
		font-size: 13px;
		flex-shrink: 0;
	}

	.game-achieve {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.game-achieve-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 11px;
		color: var(--content-meta);
	}
	.game-achieve-label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	.game-achieve-pct {
		font-weight: 600;
		color: var(--primary);
	}
	.game-achieve-bar {
		height: 4px;
		border-radius: 9999px;
		background: var(--btn-regular-bg);
		overflow: hidden;
	}
	.game-achieve-fill {
		height: 100%;
		border-radius: 9999px;
		background: linear-gradient(90deg, var(--primary), color-mix(in srgb, var(--primary) 60%, transparent));
		transition: width .3s ease;
	}

	@media (max-width: 640px) {
		.game-platform, .game-store {
			width: 22px;
			height: 22px;
			border-radius: 6px;
			top: 6px;
		}
		.game-platform { left: 6px; }
		.game-store { right: 6px; }
		.platform-icon, .store-icon { font-size: 13px; }
		.game-info { padding: 8px 10px 10px; gap: 6px; }
		.game-title { font-size: 13px; }
	}
</style>
