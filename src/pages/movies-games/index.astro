---
import { getCollection } from "astro:content";
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import ClientPagination from "@/components/common/ClientPagination.astro";
import LifeNavTabs from "@/components/pages/life/LifeNavTabs.astro";
import MovieGameCard from "@/components/pages/movies-games/MovieGameCard.astro";
import MusicCollectionCard from "@/components/pages/movies-games/MusicCollectionCard.astro";
import { musicPlayerConfig, siteConfig } from "@/config";
import doubanRatings from "@/constants/douban-ratings.json";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import { removeFileExtension } from "@/utils/url-utils";

// 豆瓣评分缓存（scripts/generate-douban-ratings.ts 构建时生成）
const doubanRatingsMap = doubanRatings as unknown as Record<
	string,
	{ rate: string; url: string; title?: string } | undefined
>;

if (!siteConfig.pages.moviesGames) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(new Date());

const metingApiBase = musicPlayerConfig.meting?.api || "";

const customBangumi = await getCollection("bangumi");

const statusMap: Record<number, string> = {
	1: "wish",
	2: "collect",
	3: "doing",
	4: "on_hold",
	5: "dropped",
};

interface MgItem {
	subject_id: number;
	subject_type: number;
	rate: number;
	type: number;
	comment: string | null;
	tags: string[];
	ep_status: number;
	vol_status: number;
	updated_at: string;
	private: boolean;
	link: string;
	douban?: { rate: string; url: string; title?: string };
	subject: {
		id: number;
		type: number;
		name: string;
		name_cn: string;
		short_summary: string;
		images: {
			medium: string;
			large: string;
			common: string;
			small: string;
			grid: string;
		};
		volumes: number;
		eps: number;
		collection_total: number;
		score: number;
		rank: number;
		tags: any[];
	};
	_subcategory?: string;
}

interface MusicItem {
	title: string;
	artist?: string;
	image: string;
	score: number;
	status: number;
	comment: string;
	musicType?: "album" | "single" | "ep";
	audioUrl: string;
	lrcUrl: string;
	metingServer: string;
	metingId: string;
	published: string;
	link: string;
	playlistIndex: number;
	hasAudio: boolean;
}

const mgItems: MgItem[] = customBangumi
	.filter((item) => ["anime", "real"].includes(item.data.category))
	.map((item) => {
		const { data, id } = item;
		const imageSrc =
			typeof data.image === "string" ? data.image : data.image.src;

		const finalLink = "/bangumi/" + removeFileExtension(id) + "/";

		// 豆瓣评分缓存（构建时由 generate-douban-ratings.ts 生成）
		const doubanEntry = data.doubanId
			? doubanRatingsMap[String(data.doubanId)]
			: undefined;

		const subjectTypeMap: Record<string, number> = {
			anime: 2,
			game: 4,
			real: 6,
		};

		const subcategory = (data as any).subcategory as string | undefined;

		return {
			subject_id: 0,
			subject_type: subjectTypeMap[data.category] || 2,
			rate: data.score || 0,
			type: data.status,
			comment: data.comment || null,
			tags: data.tags || [],
			ep_status: 0,
			vol_status: 0,
			updated_at: data.published?.toISOString() || new Date().toISOString(),
			private: false,
			link: finalLink,
			douban: doubanEntry
				? {
						rate: doubanEntry.rate,
						url: doubanEntry.url,
						title: doubanEntry.title,
					}
				: undefined,
			_subcategory: subcategory,
			subject: {
				id: 0,
				type: subjectTypeMap[data.category] || 2,
				name: data.title,
				name_cn: data.name_cn || data.title,
				short_summary: "",
				images: {
					medium: imageSrc,
					large: imageSrc,
					common: imageSrc,
					small: imageSrc,
					grid: imageSrc,
				},
				volumes: 0,
				eps: 0,
				collection_total: 0,
				score: data.score || 0,
				rank: 0,
				tags: [],
			},
		};
	})
	.sort(
		(a, b) =>
			new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime(),
	);

const musicItems: MusicItem[] = customBangumi
	.filter((item) => item.data.category === "music")
	.map((item) => {
		const { data } = item;
		const imageSrc =
			typeof data.image === "string" ? data.image : data.image.src;
		const finalLink = "/bangumi/" + removeFileExtension(item.id) + "/";
		const hasAudio = Boolean(data.audioUrl || data.metingId);
		return {
			title: data.title,
			artist: data.artist || "",
			image: imageSrc,
			score: data.score || 0,
			status: data.status,
			comment: data.comment || "",
			musicType: data.musicType,
			audioUrl: data.audioUrl || "",
			lrcUrl: data.lrcUrl || "",
			metingServer: data.metingServer || "",
			metingId: data.metingId || "",
			published: data.published?.toISOString() || new Date().toISOString(),
			link: finalLink,
			playlistIndex: -1,
			hasAudio,
		};
	})
	.sort(
		(a, b) => new Date(b.published).getTime() - new Date(a.published).getTime(),
	);

// Build playlist only from entries that have audioUrl or metingId
const musicPlaylist = musicItems
	.filter((item) => item.hasAudio)
	.map((item) => ({
		name: item.title,
		artist: item.artist || "",
		url: item.audioUrl,
		pic: item.image,
		lrc: item.lrcUrl,
		metingServer: item.metingServer || "",
		metingId: item.metingId || "",
	}));

// Assign playlist index for each music item
const musicPlaylistIndexByTitle = new Map<string, number>();
musicPlaylist.forEach((track, i) => {
	musicPlaylistIndexByTitle.set(track.name, i);
});
musicItems.forEach((item) => {
	item.playlistIndex = musicPlaylistIndexByTitle.get(item.title) ?? -1;
});

function getMusicStatusColor(type: number): string {
	switch (type) {
		case 1:
			return "bg-sky-500/80";
		case 2:
			return "bg-emerald-500/80";
		case 3:
			return "bg-amber-500/80";
		case 4:
			return "bg-violet-500/80";
		case 5:
			return "bg-rose-400/80";
		default:
			return "bg-gray-500/80";
	}
}

function getMusicStatusText(type: number): string {
	switch (type) {
		case 1:
			return i18n(I18nKey.bangumiStatusMusicWish);
		case 2:
			return i18n(I18nKey.bangumiStatusMusicListened);
		case 3:
			return i18n(I18nKey.bangumiStatusMusicListening);
		case 4:
			return i18n(I18nKey.bangumiStatusOnHold);
		case 5:
			return i18n(I18nKey.bangumiStatusDropped);
		default:
			return i18n(I18nKey.bangumiStatusUnknown);
	}
}

function getItemSubcategory(item: MgItem): string {
	if (item._subcategory) return item._subcategory;
	const tags = item.tags || [];
	if (tags.some((t: string) => t.includes("纪录"))) return "documentary";
	if (tags.some((t: string) => t.includes("动漫") || t.includes("动画")))
		return "anime";
	if (tags.some((t: string) => t.includes("电视剧") || t.includes("剧集")))
		return "tv";
	return "movie";
}

type TabKey = "all" | "movie" | "tv" | "anime" | "documentary" | "music";

const tabConfig: { key: TabKey; i18nKey: I18nKey }[] = [
	{ key: "all", i18nKey: I18nKey.moviesGamesTabAll },
	{ key: "movie", i18nKey: I18nKey.moviesGamesTabMovie },
	{ key: "tv", i18nKey: I18nKey.moviesGamesTabTV },
	{ key: "anime", i18nKey: I18nKey.moviesGamesTabAnime },
	{ key: "documentary", i18nKey: I18nKey.moviesGamesTabDocumentary },
	...(musicItems.length > 0
		? [{ key: "music" as TabKey, i18nKey: I18nKey.moviesGamesTabMusic }]
		: []),
];

interface SectionData {
	tabKey: TabKey;
	tabName: string;
	tabCount: number;
	items: MgItem[] | MusicItem[];
	filters: { value: string; label: string; count: number }[];
	isMusic: boolean;
}

const sections: SectionData[] = [];

for (const tc of tabConfig) {
	const items: MgItem[] | MusicItem[] =
		tc.key === "all"
			? mgItems
			: tc.key === "music"
				? musicItems
				: mgItems.filter((item) => {
						return getItemSubcategory(item) === tc.key;
					});

	if (tc.key !== "all" && items.length === 0) continue;

	const statusCounts: Record<string, number> = {};
	for (const item of items) {
		const statusValue = "status" in item ? item.status : (item as MgItem).type;
		const s = statusMap[statusValue] || "unknown";
		statusCounts[s] = (statusCounts[s] || 0) + 1;
	}

	const filters = [
		{
			value: "all",
			label: i18n(I18nKey.bangumiFilterAll),
			count: items.length,
		},
		{
			value: "collect",
			label: i18n(I18nKey.bangumiFilterWatched),
			count: statusCounts.collect || 0,
		},
		{
			value: "doing",
			label: i18n(I18nKey.bangumiFilterWatching),
			count: statusCounts.doing || 0,
		},
		{
			value: "wish",
			label: i18n(I18nKey.bangumiFilterWish),
			count: statusCounts.wish || 0,
		},
		{
			value: "on_hold",
			label: i18n(I18nKey.bangumiFilterOnHold),
			count: statusCounts.on_hold || 0,
		},
		{
			value: "dropped",
			label: i18n(I18nKey.bangumiFilterDropped),
			count: statusCounts.dropped || 0,
		},
	].filter((f) => f.value === "all" || f.count > 0);

	sections.push({
		tabKey: tc.key,
		tabName: i18n(tc.i18nKey),
		tabCount: items.length,
		items,
		filters,
		isMusic: tc.key === "music",
	});
}

const activeTab = sections[0]?.tabKey || "all";

// 音乐卡片初始化数据：通过 JSON script 传给全局初始化脚本（src/utils/page-tabs.ts）
const musicDataJson = JSON.stringify({
	playlist: musicPlaylist,
	metingApiUrl: metingApiBase,
}).replace(/</g, "\\u003c");
---

<MainGridLayout title={i18n(I18nKey.moviesGamesTitle)} description={i18n(I18nKey.moviesGamesSubtitle)}>
	<LifeNavTabs mode="records" />
	<div class="mg-page-wrapper flex w-full overflow-hidden relative min-h-32">
		<div data-pagefind-body class="card-base z-10 px-6 pt-8 pb-8 relative w-full">
			<!-- Page header -->
			<header class="mg-header relative w-full mb-8">
				<div class="flex items-center gap-3 mb-4">
					<div class="mg-icon flex items-center justify-center w-12 h-12 rounded-2xl bg-[var(--primary)]/10 dark:bg-[var(--primary)]/15 border border-[var(--primary)]/20 shadow-sm">
						<Icon name="material-symbols:movie-outline-rounded" class="text-[1.4rem] text-[var(--primary)]" />
					</div>
					<div>
						<h1 data-pagefind-meta="title" data-pagefind-weight="10" class="">
							{i18n(I18nKey.moviesGamesTitle)}
						</h1>
					</div>
				</div>
				<p class="text-sm text-[var(--content-meta)] leading-relaxed pl-[3.5rem]">
					{i18n(I18nKey.moviesGamesSubtitle)}
				</p>
				<p class="text-xs text-[var(--content-meta)] opacity-60 mt-1.5 pl-[3.5rem]">
					{i18n(I18nKey.bangumiLastUpdated)} {buildTime}
				</p>
			</header>

			{mgItems.length > 0 ? (
				<>
					<!-- Tab Navigation -->
					<div class="mg-tabs-wrapper mb-6">
						<nav class="flex gap-1 p-1 bg-[var(--btn-regular-bg)] dark:bg-[var(--card-bg)] rounded-xl border border-[var(--line-divider)] overflow-x-auto scrollbar-hide" aria-label="Tabs">
							{sections.map((sec) => (
								<button
									class:list={[
										"mg-tab flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 flex-shrink-0",
										sec.tabKey === activeTab
											? "bg-[var(--card-bg)] dark:bg-[var(--btn-regular-bg)] text-[var(--primary)] shadow-sm"
											: "text-[var(--content-meta)] hover:text-[var(--deep-text)] hover:bg-[var(--btn-card-bg-hover)]",
									]}
									data-tab={sec.tabKey}
									type="button"
								>
									<span>{sec.tabName}</span>
									<span class:list={[
										"text-[10px] font-semibold px-1.5 py-0.5 rounded-full tabular-nums",
										sec.tabKey === activeTab
											? "bg-[var(--primary)]/10 text-[var(--primary)]"
											: "bg-[var(--btn-regular-bg)] text-[var(--content-meta)]",
									]}>
										{sec.tabCount}
									</span>
								</button>
							))}
						</nav>
					</div>

					<!-- Sections -->
					{sections.map((sec) => (
						<div class:list={["mg-section", { "hidden": sec.tabKey !== activeTab }]} data-section={sec.tabKey}>
							{sec.items.length > 0 ? (
								<>
									<!-- Filters -->
									<div class="mg-filter-wrapper flex flex-wrap gap-2 mb-5">
										{sec.filters.map((filter) => (
											<button
												class:list={[
													"mg-filter-btn flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium transition-all duration-200 border flex-shrink-0",
													filter.value === "all"
														? "bg-[var(--primary)] text-white border-[var(--primary)] shadow-sm"
														: "bg-[var(--card-bg)] text-[var(--content-meta)] border-[var(--line-divider)] hover:border-[var(--primary)]/30 hover:text-[var(--deep-text)]",
												]}
												data-filter={filter.value}
												data-section={sec.tabKey}
												type="button"
											>
												<span>{filter.label}</span>
												<span class="text-[10px] font-semibold tabular-nums">({filter.count})</span>
											</button>
										))}
									</div>

									<!-- Grid -->
									<div class="mg-grid grid grid-cols-3 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-5">
										{sec.isMusic
											? (sec.items as MusicItem[]).map((item) => (
													<div
														class="mg-item music-item"
														data-item-section={sec.tabKey}
														data-item-status={statusMap[item.status] || "unknown"}
													>
														<MusicCollectionCard
															title={item.title}
															artist={item.artist}
															image={item.image}
															score={item.score}
															statusText={getMusicStatusText(item.status)}
															statusColor={getMusicStatusColor(item.status)}
															comment={item.comment}
															musicType={item.musicType}
															hasAudio={item.hasAudio}
															playlistIndex={item.playlistIndex}
														/>
													</div>
												))
											: (sec.items as MgItem[]).map((item) => (
													<div
														class="mg-item"
														data-item-section={sec.tabKey}
														data-item-status={statusMap[item.type] || "unknown"}
													>
														<MovieGameCard item={item as any} link={item.link} />
													</div>
												))}
									</div>

									<ClientPagination
										totalItems={sec.items.length}
										itemsPerPage={12}
										itemsPerPageMobile={6}
										currentPage={1}
										sectionId={sec.tabKey}
									/>
								</>
							) : (
								<div class="flex flex-col items-center justify-center py-16 text-center">
									<p class="text-sm text-[var(--content-meta)]">{i18n(I18nKey.moviesGamesNoData)}</p>
								</div>
							)}
						</div>
					))}
				</>
			) : (
				<div class="flex flex-col items-center justify-center py-20 text-center">
					<div class="inline-flex items-center justify-center w-14 h-14 bg-[var(--btn-regular-bg)] rounded-2xl mb-4 border border-[var(--line-divider)]">
						<Icon name="material-symbols:movie-outline" class="w-7 h-7 text-[var(--content-meta)]" />
					</div>
					<h3 class="text-base font-medium text-[var(--deep-text)] dark:text-[var(--title-active)] mb-1.5">
						{i18n(I18nKey.moviesGamesNoData)}
					</h3>
				</div>
			)}
		</div>
	</div>
<Comment customPath="/movies-games/" />
</MainGridLayout>

<style>
	.mg-page-wrapper {
		border-radius: var(--radius-large);
	}

	.mg-header {
		animation: fadeSlideIn 0.4s ease-[var(--ease-standard)] both;
	}

	.mg-icon {
		transition: transform 0.2s ease-[var(--ease-standard)];
	}
	.mg-icon:hover {
		transform: scale(1.05);
	}

	@keyframes fadeSlideIn {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.mg-section {
		animation: fadeIn 0.3s ease-[var(--ease-standard)] both;
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.scrollbar-hide {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 640px) {
		.card-base {
			padding-left: 1rem;
			padding-right: 1rem;
			padding-top: 1.5rem;
			padding-bottom: 1.5rem;
		}
	}
</style>

<script is:inline type="application/json" id="mg-music-data" data-swup-ignore-script set:html={musicDataJson} />

